---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const frame = (slug: string, title: string, hgt: number) => `<iframe src="${SITE_URL}/embed/${slug}/" title="${title}" width="100%" height="${hgt}" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
const codes = [
  ['Which trusted traveler program?', frame('which-trusted-traveler-program', 'Which trusted traveler program should I get?', 900)],
  ['Cost over five and ten years', frame('trusted-traveler-cost-calculator', 'Trusted traveler cost calculator', 820)],
  ['Renewal dates and calendar reminder', frame('renewal-reminder', 'PreCheck and Global Entry renewal dates', 640)],
];
---
<PageLayout title="Embed the free trusted traveler chooser on your website" description="Put the PreCheck, Global Entry and CLEAR chooser, the five and ten year cost calculator or the renewal reminder on your site: one iframe, no sign-up, no tracking, no cost." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed a trusted traveler tool</h1>
    <p class="mt-3 text-lg text-navy-700">For travel guides, corporate travel desks, study-abroad offices and community sites.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {codes.map(([title, code]) => (<><h2>{title}</h2><pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre></>))}
    <p>Conditions: keep the credit line under the frame visible and use the tool as it is, without warranty. When TSA, CBP or CLEAR change a fee, the embedded tool updates with the site. Nothing your visitors type reaches us and the frame sets no cookie. Each frame states that the site is independent and not a government service. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/which-trusted-traveler-program/" title="Which trusted traveler program?" width="100%" height="900" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
